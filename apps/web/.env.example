# LLM provider (OpenRouter by default). Either key name is accepted.
OPENROUTER_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_JUDGE=deepseek/deepseek-v3.2
LLM_MODEL_SYNTH=google/gemini-3.8-flash
LLM_MODEL_PROBE=perplexity/sonar-pro:online
LLM_TASK_MODELS={}
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_CONCURRENCY=4
LLM_MAX_SPEND_PER_AUDIT_USD=1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AEO Audit

# Optional third-party integrations
BRAVE_SEARCH_API_KEY=
GSC_ACCESS_TOKEN=
BING_API_KEY=
BING_ACCESS_TOKEN=
INDEXNOW_KEY=
PROBE_QUERIES=[]
PROBE_SAMPLES=1
PROBE_COST_PER_SAMPLE_USD=0

# Browser rendering. Set ENABLE_BROWSER=true to allow API requests for rendering.
ENABLE_BROWSER=false
RENDERER=chromium
CDP_ENDPOINT=

# In-memory per-IP token bucket controls
# Enable only behind a trusted proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
RATE_LIMIT_BURST=5
RATE_LIMIT_REFILL_MS=12000

# CLI display control (empty/undefined enables automatic terminal colors)
NO_COLOR=

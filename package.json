{
  "name": "audit-website-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "audit": "bun apps/cli/src/index.ts audit",
    "checks": "bun apps/cli/src/index.ts checks",
    "verify": "bun apps/cli/src/index.ts verify"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
